#!/bin/bash
set -e
# Apply BreezeDark flatpak overrides.
# kdeglobals hash: {{ include "dot_config/private_kdeglobals" | sha256sum }}

mkdir -p ~/.local/share/flatpak/overrides
flatpak override --user --filesystem=xdg-config/kdeglobals:ro
flatpak override --user --env=QT_QPA_PLATFORMTHEME=kde
{{- end -}}
