_default:
	just --choose

{{- if eq .chezmoi.hostname "bazzite" }}
# Download Steam Workshop maps to the local L4D2 addons folder.
[positional-arguments]
l4d2-download +items:
	@~/scripts/l4d2-download.py "$@"
{{- end }}

# Ensure Sunshine binary has Linux capability for direct KMS capture.
_ensure_sunshine_cap:
	#!/usr/bin/bash
	SUNSHINE_BIN=$(readlink -f "$(which sunshine 2>/dev/null)" 2>/dev/null || echo "")
	if [[ -n "$SUNSHINE_BIN" ]] && ! getcap "$SUNSHINE_BIN" 2>/dev/null | grep -q cap_sys_admin; then
		echo "Missing CAP_SYS_ADMIN on sunshine binary, granting..."
		sudo setcap cap_sys_admin+ep "$SUNSHINE_BIN"
	fi

_start_sunshine:
	brew services start sunshine

# Run kscreen-doctor against the KDE Wayland session (works over SSH too).
_kscreen *args:
	QT_QPA_PLATFORM=wayland WAYLAND_DISPLAY=wayland-0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus kscreen-doctor {{ "{{" }}args}} 2>&1 || true

_unlock_gnome:
	#!/usr/bin/bash
	set -euo pipefail

	if loginctl list-sessions 2>/dev/null | grep -q 'lava.*seat0'; then
		echo "Session already active on seat0."
		busctl --user set-property org.gnome.Mutter.DisplayConfig /org/gnome/Mutter/DisplayConfig org.gnome.Mutter.DisplayConfig PowerSaveMode i 0 2>/dev/null || true
		loginctl unlock-sessions 2>/dev/null || true
		exit 0
	fi

	GDM_CONF="/etc/gdm/custom.conf"
	GDM_BAK="/etc/gdm/custom.conf.bak"

	cleanup() {
		echo "Cleaning up GDM config..."
		sudo bash -c "
			if [[ -f '$GDM_BAK' ]]; then
				mv -f '$GDM_BAK' '$GDM_CONF'
			else
				printf '# GDM configuration storage\n\n[daemon]\n\n[security]\n\n[debug]\n# Uncomment the line below to turn on debugging\n#Enable=true\n' > '$GDM_CONF'
			fi
		"
	}
	trap cleanup EXIT

	sudo bash -c "
		cp -f '$GDM_CONF' '$GDM_BAK' 2>/dev/null || true
		printf '# GDM configuration storage\n\n[daemon]\nAutomaticLoginEnable=True\nAutomaticLogin=lava\n\n[security]\n\n[debug]\n# Uncomment the line below to turn on debugging\n#Enable=true\n' > '$GDM_CONF'
		systemctl restart gdm
	"

	echo "Waiting for session..."
	for i in {1..30}; do
		if loginctl list-sessions 2>/dev/null | grep -q 'lava.*seat0'; then
			echo "Session found, waiting 10s for services to settle..."
			sleep 10
			busctl --user set-property org.gnome.Mutter.DisplayConfig /org/gnome/Mutter/DisplayConfig org.gnome.Mutter.DisplayConfig PowerSaveMode i 0 2>/dev/null || true
			loginctl unlock-sessions 2>/dev/null || true
			echo "Session started successfully."
			exit 0
		fi
		sleep 1
	done

	echo "Timed out waiting for session." >&2
	exit 1

alias _unlock := unlock

unlock:
	#!/usr/bin/bash
	set -euo pipefail

	CONF_DIR="/etc/plasmalogin.conf.d"
	PAM_DIR="/etc/pam.d"

	sudo bash -c "
		rm -f '$CONF_DIR/99-plasma-setup.conf'
		printf '[Autologin]\nUser=lava\nSession=plasma\n' > '$CONF_DIR/99-autologin.conf'
		printf '#%%PAM-1.0\nauth        sufficient   pam_permit.so\naccount     sufficient   pam_permit.so\npassword    sufficient   pam_permit.so\nsession     include      password-auth\n' > '$PAM_DIR/plasmalogin'
		printf '#%%PAM-1.0\nauth        sufficient   pam_permit.so\naccount     sufficient   pam_permit.so\npassword    sufficient   pam_permit.so\nsession     include      password-auth\n' > '$PAM_DIR/plasmalogin-autologin'
		printf '#%%PAM-1.0\nauth        include      password-auth\naccount     include      password-auth\npassword    include      password-auth\nsession     include      password-auth\n' > '$PAM_DIR/plasmalogin-greeter'
		systemctl restart plasmalogin
	"

	echo "Waiting for session..."
	for i in {1..30}; do
		if loginctl list-sessions 2>/dev/null | grep -q 'lava.*seat0'; then
			echo "Session found, waiting 10s for services to settle..."
			sleep 10
			sudo bash -c "
				rm -f '$CONF_DIR/99-autologin.conf' \
				      '$PAM_DIR/plasmalogin' \
				      '$PAM_DIR/plasmalogin-autologin' \
				      '$PAM_DIR/plasmalogin-greeter'
			"
			echo "Session started. Cleaned up."
			exit 0
	fi

		sleep 1
	done
	sudo bash -c "
		rm -f '$CONF_DIR/99-autologin.conf' \
		      '$PAM_DIR/plasmalogin' \
		      '$PAM_DIR/plasmalogin-autologin' \
		      '$PAM_DIR/plasmalogin-greeter'
	"
	echo "Timed out waiting for session. Cleaned up." >&2
	exit 1

fix-local-dimming:
	#!/bin/bash
	kscreen-doctor --dpms off && sleep 1 && kscreen-doctor --dpms on

_fix-local-dimming_gnome:
	busctl --user set-property org.gnome.Mutter.DisplayConfig /org/gnome/Mutter/DisplayConfig org.gnome.Mutter.DisplayConfig PowerSaveMode i 1
	sleep 1
	busctl --user set-property org.gnome.Mutter.DisplayConfig /org/gnome/Mutter/DisplayConfig org.gnome.Mutter.DisplayConfig PowerSaveMode i 0

# Switch to the physical monitor (DP-2 on, HDMI dummy off).
[group("display")]
dp: _ensure_sunshine_cap && _start_sunshine
	brew services stop sunshine
	just _kscreen output.DP-2.enable output.HDMI-A-1.disable

# Switch to the HDMI dummy plug (for headless streaming).
[group("display")]
dummy: _ensure_sunshine_cap && _start_sunshine
	brew services stop sunshine
	just _kscreen output.HDMI-A-1.enable output.DP-2.disable

_dp_gnome:
	#!/usr/bin/bash
	set -euo pipefail
	BUS="org.gnome.Mutter.DisplayConfig"
	OBJ="/org/gnome/Mutter/DisplayConfig"
	CONFIG="[(0, 0, 1.0, uint32 0, true, [('DP-2', '2560x1440@199.999+vrr', {'color-mode': <uint32 1>})])]"
	# systemctl --user stop gnome-remote-desktop.service 2>/dev/null || true
	busctl --user set-property "$BUS" "$OBJ" "$BUS" PowerSaveMode i 0 2>/dev/null || true
	loginctl unlock-sessions 2>/dev/null || true

	for i in {1..5}; do
		SERIAL=$(gdbus call --session --dest "$BUS" --object-path "$OBJ" --method "$BUS.GetCurrentState" 2>/dev/null | grep -oP '^\(uint32 \K\d+' || true)
		if [[ -n "$SERIAL" ]] && gdbus call --session --dest "$BUS" --object-path "$OBJ" --method "$BUS.ApplyMonitorsConfig" "$SERIAL" 1 "$CONFIG" "{}" >/dev/null 2>&1; then
			busctl --user set-property "$BUS" "$OBJ" "$BUS" PowerSaveMode i 0 2>/dev/null || true
			# systemctl --user start gnome-remote-desktop.service 2>/dev/null || true
			echo "Switched to DP-2 (physical monitor at 200Hz VRR + HDR)."
			exit 0
		fi
		sleep 0.5
	done
	# systemctl --user start gnome-remote-desktop.service 2>/dev/null || true
	echo "Failed to switch to DP-2." >&2
	exit 1

_dummy_gnome res="1920x1200":
	#!/usr/bin/bash
	set -euo pipefail
	BUS="org.gnome.Mutter.DisplayConfig"
	OBJ="/org/gnome/Mutter/DisplayConfig"

	case "{{ "{{" }} res }}" in
		1080|1920x1080)
			MODE="1920x1080@60.000"
			;;
		1200|1920x1200)
			MODE="1920x1200@59.950"
			;;
		4k|3840x2160)
			MODE="3840x2160@59.982"
			;;
		*)
			echo "Unknown resolution: {{ "{{" }} res }}. Use '1920x1200' (default), '1920x1080', or '4k'." >&2
			exit 1
			;;
	esac

	CONFIG="[(0, 0, 1.0, uint32 0, true, [('HDMI-1', '$MODE', {})])]"
	# systemctl --user stop gnome-remote-desktop.service 2>/dev/null || true
	busctl --user set-property "$BUS" "$OBJ" "$BUS" PowerSaveMode i 0 2>/dev/null || true

	for i in {1..5}; do
		SERIAL=$(gdbus call --session --dest "$BUS" --object-path "$OBJ" --method "$BUS.GetCurrentState" 2>/dev/null | grep -oP '^\(uint32 \K\d+' || true)
		if [[ -n "$SERIAL" ]] && gdbus call --session --dest "$BUS" --object-path "$OBJ" --method "$BUS.ApplyMonitorsConfig" "$SERIAL" 1 "$CONFIG" "{}" >/dev/null 2>&1; then
			busctl --user set-property "$BUS" "$OBJ" "$BUS" PowerSaveMode i 0 2>/dev/null || true
			# systemctl --user start gnome-remote-desktop.service 2>/dev/null || true
			echo "Switched to HDMI-1 (dummy plug) at $MODE."
			exit 0
		fi
		sleep 0.5
	done
	# systemctl --user start gnome-remote-desktop.service 2>/dev/null || true
	echo "Failed to switch to HDMI-1." >&2
	exit 1

# Flip the HDMI dummy plug between 1920x1080 and 1920x1200.
[group("display")]
toggle-hdmi-res: && _start_sunshine
	#!/bin/bash
	brew services stop sunshine
	CURRENT=$(just _kscreen --outputs | grep -oP '\d+x\d+(?=@\d+\.\d+\*)' | head -1)
	if [[ "$CURRENT" == "2560x1440" ]]; then
		just _kscreen output.HDMI-A-1.mode.1920x1080@60
	else
		just _kscreen output.HDMI-A-1.mode.1920x1200@60
	fi

_restart_plasma_shell:
	systemctl --user restart plasma-plasmashell.service
