# Local secrets consumed via environment indirection; chezmoi must never overwrite them
.omp/agent/.env

# Non-chezmoi repo files (helpers; not home targets)
README.md
AGENTS.md
LICENSE
.gitignore
sync-zed-vscode-theme.py
docs/**
scripts/zero-g-discovery.test.ts
package.json
bun.lock
tsconfig.json
node_modules/**
*.tsbuildinfo

# Desktop / Bazzite-only items (Flatpak apps, KDE theme, fontconfig, scripts)
{{- if ne .chezmoi.hostname "bazzite" }}
.var/**
.config/environment.d/kde-dark.conf
.config/fontconfig/**
.config/kdeglobals
.config/kwinrc
.config/plasma-org.kde.plasma.desktop-appletsrc
.config/plasmashellrc
.config/konsolerc
.config/gtk-3.0/**
.config/gtk-4.0/**
.config/kglobalshortcutsrc
.justfile
.config/systemd/user/disk-cleanup.*
.local/**
scripts/**
{{- end }}

# Linux-only items: excluded on non-Linux machines.
# Per-host scoping of systemd units lives in the units themselves
# (ConditionPathExists=/ConditionHost=), not here.
{{- if ne .chezmoi.os "linux" }}
.config/environment.d/**
.config/fontconfig/**
.config/systemd/**
.config/kdeglobals
.config/kwinrc
.config/plasma-org.kde.plasma.desktop-appletsrc
.config/plasmashellrc
.config/konsolerc
.config/gtk-3.0/**
.config/gtk-4.0/**
.config/kglobalshortcutsrc
.bashrc_custom
.tmux.conf
{{- end }}