[user]
	name = Delnegend
	email = kiennguyen19323@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICZ1bFKiON1FiBKewwM6xwkW/UNnAXT7mu6uEgekYYh5
[commit]
	gpgsign = true
[gpg]
	format = ssh
[pull]
	rebase = true
[init]
	defaultBranch = main
[gpg "ssh"]
{{- if eq .chezmoi.os "windows" }}
	allowedSignersFile = ~/.config/git/allowed_signers
	program = C:/Windows/System32/OpenSSH/ssh-keygen.exe
{{- else }}
	defaultKeyCommand = ssh-add -L
	allowedSignersFile = ~/.config/git/allowed_signers
{{- end }}
[core]
{{- if eq .chezmoi.os "windows" }}
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- end }}
[credential "https://github.com"]
	helper =
{{- if eq .chezmoi.os "windows" }}
	helper = !'C:\\Program Files\\GitHub CLI\\gh.exe' auth git-credential
{{- else }}
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
{{- end }}
[credential "https://gist.github.com"]
	helper =
{{- if eq .chezmoi.os "windows" }}
	helper = !'C:\\Program Files\\GitHub CLI\\gh.exe' auth git-credential
{{- else }}
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
{{- end }}
{{- if eq .chezmoi.os "windows" }}
[credential "https://git.delnegend.com"]
	provider = generic
{{- end }}
