{{- if eq .chezmoi.hostname "bazzite" -}}
#!/bin/bash
set -e
# Install udev rule to disable NCQ for the Intel D3-S4510 SATA SSD.

sudo mkdir -p /etc/udev/rules.d
sudo tee /etc/udev/rules.d/99-disable-ncq-s4510.rules > /dev/null <<'EOF'
# Match by serial to set queue_depth=1 (disables NCQ) regardless of sdX assignment.
ACTION=="add|change", SUBSYSTEM=="block", KERNEL=="sd[a-z]", ATTRS{serial}=="BTYS810202MW1P9DGN", ATTR{device/queue_depth}="1"
EOF
sudo udevadm control --reload-rules
sudo udevadm trigger --action=change --subsystem-match=block --attr-match=serial=BTYS810202MW1P9DGN
{{- end -}}
