{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -eu
# Register only when absent; preserve Claude's other state and existing servers.
# Bootstrap installs Claude Code with Homebrew, whose bin may not be on PATH yet.
PATH="$PATH:/home/linuxbrew/.linuxbrew/bin:/var/home/linuxbrew/.linuxbrew/bin"
if ! command -v claude >/dev/null 2>&1; then
    # Fail instead of skipping: chezmoi records a successful run as done and
    # would never retry, leaving Claude Code without MemPalace.
    echo "claude not found: MemPalace not registered; rerun chezmoi apply once Claude Code is installed" >&2
    exit 1
fi
if claude mcp get mempalace >/dev/null 2>&1; then
    exit 0
fi
claude mcp add-json --scope user mempalace "$(cat "$HOME/.claude/mempalace-mcp.json")"
{{- end -}}
