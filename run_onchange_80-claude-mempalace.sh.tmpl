{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -eu
# Register only when absent; preserve Claude's other state and existing servers.
if ! command -v claude >/dev/null 2>&1 || ! command -v bun >/dev/null 2>&1; then
    exit 0
fi
if bun -e 'const f = Bun.file(`${process.env.HOME}/.claude.json`); const c = await f.exists() ? await f.json() : {}; process.exit(c.mcpServers?.mempalace ? 0 : 1)'; then
    exit 0
fi
claude mcp add-json --scope user mempalace "$(cat "$HOME/.claude/mempalace-mcp.json")"
{{- end -}}
