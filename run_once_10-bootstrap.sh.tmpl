{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -e
# run_once: base packages + Homebrew + shell wiring (ex-scripts/bootstrap.sh).
# Re-runs only when this file's hash changes.

# Resolve brew across standard Linux Homebrew layouts (Bazzite uses /var/home).
BREW=""
for c in /home/linuxbrew/.linuxbrew/bin/brew /var/home/linuxbrew/.linuxbrew/bin/brew; do
    if [ -x "$c" ]; then BREW="$c"; break; fi
done
[ -z "$BREW" ] && command -v brew &>/dev/null && BREW="$(command -v brew)"

export NONINTERACTIVE=1
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_ASK=1

install_sys() {
    if command -v apt-get &>/dev/null; then
        sudo apt-get install -y "$@"
    elif command -v dnf &>/dev/null; then
        sudo dnf install -y "$@"
    elif command -v yum &>/dev/null; then
        sudo yum install -y "$@"
    fi
}

if ! command -v git &>/dev/null; then
    echo "Installing git..."
    install_sys git curl
fi

if [ ! -x "$BREW" ]; then
    echo "Installing Homebrew..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" < /dev/null
fi

if [ ! -x "$BREW" ]; then
    for c in /home/linuxbrew/.linuxbrew/bin/brew /var/home/linuxbrew/.linuxbrew/bin/brew; do
        if [ -x "$c" ]; then BREW="$c"; break; fi
    done
fi
[ -x "$BREW" ] || { echo "Cannot locate brew after install" >&2; exit 1; }

eval "$("$BREW" shellenv)"

# Homebrew 6.0+ requires explicit trust for non-official taps. Trust only the
# specific items we install (minimal scope). No explicit `brew tap` here: a
# fully-qualified install auto-taps and auto-trusts its item, and running
# `brew tap <tap>` first would try to load every formula in the tap and fail.
"$BREW" trust --formula anomalyco/tap/opencode
"$BREW" trust --cask ublue-os/tap/antigravity-cli-linux

pkgs=(
    "just:just"
    "zoxide:zoxide"
    "starship:starship"
    "fzf:fzf"
    "opencode:anomalyco/tap/opencode"
    "agy:--cask ublue-os/tap/antigravity-cli-linux"
)

for entry in "${pkgs[@]}"; do
    cmd="${entry%%:*}"
    args="${entry#*:}"
    if ! command -v "$cmd" &>/dev/null; then
        if [ "$cmd" = "agy" ] && command -v antigravity &>/dev/null; then
            continue
        fi
        echo "Installing $cmd..."
        attempt=0
        until "$BREW" install $args; do
            attempt=$((attempt + 1))
            if [ "$attempt" -ge 3 ]; then
                echo "Failed to install $cmd after 3 attempts" >&2
                exit 1
            fi
            echo "Retrying $cmd (attempt $((attempt + 1))/3) after transient failure..."
            sleep $((attempt * 5))
        done
    fi
done

echo "Wiring bash..."
# chezmoi manages ~/.bashrc_custom (dot_bashrc_custom); ensure ~/.bashrc sources it.
# Migrates the old cfg-system path if present.
if grep -q 'source ~/dotfiles/cfg-system/bashrc_custom' "$HOME/.bashrc" 2>/dev/null; then
    sed -i 's|source ~/dotfiles/cfg-system/bashrc_custom|source ~/.bashrc_custom|' "$HOME/.bashrc"
elif ! grep -q 'source ~/.bashrc_custom' "$HOME/.bashrc" 2>/dev/null; then
    echo >> "$HOME/.bashrc"
    echo 'source ~/.bashrc_custom' >> "$HOME/.bashrc"
fi

echo "Done! Restart your shell or run: source ~/.bashrc"
{{- end -}}
