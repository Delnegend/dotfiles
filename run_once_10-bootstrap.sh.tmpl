{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -e
# run_once: base packages + Homebrew + shell wiring (ex-scripts/bootstrap.sh).
# Re-runs only when this file's hash changes.

BREW="/home/linuxbrew/.linuxbrew/bin/brew"
export NONINTERACTIVE=1
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ANALYTICS=1

install_sys() {
    if command -v apt-get &>/dev/null; then
        sudo apt-get install -y "$@"
    elif command -v dnf &>/dev/null; then
        sudo dnf install -y "$@"
    elif command -v yum &>/dev/null; then
        sudo yum install -y "$@"
    fi
}

if ! command -v git &>/dev/null; then
    echo "Installing git..."
    install_sys git curl
fi

if [ ! -x "$BREW" ]; then
    echo "Installing Homebrew..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" < /dev/null
fi

for pkg in just zoxide starship fzf; do
    if ! command -v "$pkg" &>/dev/null; then
        echo "Installing $pkg..."
        "$BREW" install "$pkg"
    fi
done

eval "$("$BREW" shellenv)"

if ! command -v agy &>/dev/null && ! command -v antigravity &>/dev/null; then
    echo "Installing antigravity-cli-linux from ublue-os/tap..."
    "$BREW" tap ublue-os/tap
    "$BREW" trust ublue-os/tap 2>/dev/null || true
    "$BREW" install --cask antigravity-cli-linux
fi

if ! command -v opencode &>/dev/null; then
    echo "Installing opencode from anomalyco/tap..."
    "$BREW" tap anomalyco/tap
    "$BREW" trust anomalyco/tap/opencode 2>/dev/null || true
    "$BREW" install anomalyco/tap/opencode
fi

echo "Wiring bash..."
# chezmoi manages ~/.bashrc_custom (dot_bashrc_custom); ensure ~/.bashrc sources it.
# Migrates the old cfg-system path if present.
if grep -q 'source ~/dotfiles/cfg-system/bashrc_custom' "$HOME/.bashrc" 2>/dev/null; then
    sed -i 's|source ~/dotfiles/cfg-system/bashrc_custom|source ~/.bashrc_custom|' "$HOME/.bashrc"
elif ! grep -q 'source ~/.bashrc_custom' "$HOME/.bashrc" 2>/dev/null; then
    echo >> "$HOME/.bashrc"
    echo 'source ~/.bashrc_custom' >> "$HOME/.bashrc"
fi

echo "Done! Restart your shell or run: source ~/.bashrc"
{{- end -}}
