{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -e
# run_once: base packages + Homebrew + shell wiring (ex-scripts/bootstrap.sh).
# Re-runs only when this file's hash changes.

# Create the shared agent secrets file without exposing new credentials.
mkdir -p "$HOME/.config/ai-agents"
(umask 077; touch "$HOME/.config/ai-agents/secrets.env")

# Resolve brew across standard Linux Homebrew layouts (Bazzite uses /var/home).
BREW=""
for c in /home/linuxbrew/.linuxbrew/bin/brew /var/home/linuxbrew/.linuxbrew/bin/brew; do
    if [ -x "$c" ]; then BREW="$c"; break; fi
done
[ -z "$BREW" ] && command -v brew &>/dev/null && BREW="$(command -v brew)"

export NONINTERACTIVE=1
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_ASK=1

install_sys() {
    if command -v apt-get &>/dev/null; then
        sudo apt-get install -y "$@"
    elif command -v dnf &>/dev/null; then
        sudo dnf install -y "$@"
    elif command -v yum &>/dev/null; then
        sudo yum install -y "$@"
    fi
}

if ! command -v git &>/dev/null; then
    echo "Installing git..."
    install_sys git curl
fi

if [ ! -x "$BREW" ]; then
    # Shallow clone of the latest release instead of Homebrew's install.sh, which fetches
    # the full git history and runs an extra `brew update` (~20s vs ~7s). `brew update`
    # still works on a shallow clone. Mirrors what install.sh sets up on Linux.
    echo "Installing Homebrew (shallow clone)..."
    prefix=/home/linuxbrew/.linuxbrew
    sudo install -d -o "$(id -un)" -g "$(id -gn)" -m 0755 "$prefix"
    mkdir -p "$prefix"/{bin,etc,include,lib,sbin,share,opt,var/homebrew/linked,Cellar,Caskroom,Frontend}
    tag="$(git ls-remote --tags --refs --sort=-v:refname https://github.com/Homebrew/brew 'refs/tags/[0-9]*' \
        | sed 's#.*refs/tags/##' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | head -n1)"
    [ -n "$tag" ] || { echo "Cannot find the latest Homebrew release tag" >&2; exit 1; }
    git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$tag" \
        https://github.com/Homebrew/brew "$prefix/Homebrew"
    ln -sf ../Homebrew/bin/brew "$prefix/bin/brew"
fi

if [ ! -x "$BREW" ]; then
    for c in /home/linuxbrew/.linuxbrew/bin/brew /var/home/linuxbrew/.linuxbrew/bin/brew; do
        if [ -x "$c" ]; then BREW="$c"; break; fi
    done
fi
[ -x "$BREW" ] || { echo "Cannot locate brew after install" >&2; exit 1; }

eval "$("$BREW" shellenv)"

# Homebrew on Linux does not symlink unversioned compiler binaries (gcc, g++, etc.),
# causing non-bottled taps and source builds to fail with "No developer tools installed".
# Link unversioned gcc/g++ from Homebrew's versioned binaries if present.
brew_prefix="$("$BREW" --prefix)"
latest_gcc="$(find "$brew_prefix/bin" -maxdepth 1 -name "gcc-[0-9]*" 2>/dev/null | sort -V | tail -n 1)"
if [ -n "$latest_gcc" ]; then
    suffix="${latest_gcc##*-}"
    ln -sf "$latest_gcc" "$brew_prefix/bin/gcc"
    [ -e "$brew_prefix/bin/g++-$suffix" ] && ln -sf "$brew_prefix/bin/g++-$suffix" "$brew_prefix/bin/g++"
    [ -e "$brew_prefix/bin/cpp-$suffix" ] && ln -sf "$brew_prefix/bin/cpp-$suffix" "$brew_prefix/bin/cpp"
    [ -e "$brew_prefix/bin/c++-$suffix" ] && ln -sf "$brew_prefix/bin/c++-$suffix" "$brew_prefix/bin/c++"
fi

# Homebrew 6.0+ requires explicit trust for non-official taps. Trust only the
# specific items we install (minimal scope). No explicit `brew tap` here: a
# fully-qualified install auto-taps and auto-trusts its item, and running
# `brew tap <tap>` first would try to load every formula in the tap and fail.
"$BREW" trust --formula can1357/tap/omp
"$BREW" trust --formula anomalyco/tap/opencode-v2
"$BREW" trust --formula Delnegend/tap/zero-g-agy-integration

# Skip optional per-install work (cleanup, dependents scan, hints).
export HOMEBREW_NO_INSTALL_CLEANUP=1
export HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1
export HOMEBREW_NO_ENV_HINTS=1

retry() {
    local attempt=0
    until "$@"; do
        attempt=$((attempt + 1))
        if [ "$attempt" -ge 3 ]; then
            echo "Failed after 3 attempts: $*" >&2
            return 1
        fi
        echo "Retrying (attempt $((attempt + 1))/3) after transient failure..."
        sleep $((attempt * 5))
    done
}

# Download the formula index once, before two brew processes start.
"$BREW" info --formula just >/dev/null 2>&1 || true

# Casks install in a second brew process while the formulas install. They share no
# dependencies with the formulas. Do NOT run more brew processes alongside: formulas
# that share dependencies collide on Homebrew's per-package locks.
casks=()
for entry in agy:antigravity-cli claude:claude-code; do
    command -v "${entry%%:*}" &>/dev/null || casks+=("${entry#*:}")
done
if [ "${#casks[@]}" -gt 0 ]; then
    echo "Installing casks ${casks[*]} (in parallel)..."
    retry "$BREW" install --cask "${casks[@]}" &
    cask_pid=$!
fi

# One brew call for all formulas, so every download runs in parallel.
formulas=()
for entry in \
    just:just zoxide:zoxide starship:starship fzf:fzf ssh:openssh tmux:tmux bun:bun node:node \
    opencode:anomalyco/tap/opencode-v2 omp:can1357/tap/omp \
    zero-g-agy-integration:Delnegend/tap/zero-g-agy-integration; do
    command -v "${entry%%:*}" &>/dev/null || formulas+=("${entry#*:}")
done
if [ "${#formulas[@]}" -gt 0 ]; then
    echo "Installing ${formulas[*]}..."
    retry "$BREW" install --formula "${formulas[@]}"
fi

# Wait for the casks; set -e fails the script if they failed.
if [ -n "${cask_pid:-}" ]; then
    wait "$cask_pid"
fi

echo "Wiring bash..."
# chezmoi manages ~/.bashrc_custom (dot_bashrc_custom.tmpl); ensure ~/.bashrc sources it.
# Migrates the old cfg-system path if present.
if grep -q 'source ~/dotfiles/cfg-system/bashrc_custom' "$HOME/.bashrc" 2>/dev/null; then
    sed -i 's|source ~/dotfiles/cfg-system/bashrc_custom|source ~/.bashrc_custom|' "$HOME/.bashrc"
elif ! grep -q 'source ~/.bashrc_custom' "$HOME/.bashrc" 2>/dev/null; then
    echo >> "$HOME/.bashrc"
    echo 'source ~/.bashrc_custom' >> "$HOME/.bashrc"
fi

echo "Wiring chezmoi remote to SSH..."
repo="$HOME/.local/share/chezmoi"
url="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
if [ "$url" = "https://github.com/Delnegend/dotfiles.git" ]; then
    git -C "$repo" remote set-url origin git@github.com:Delnegend/dotfiles.git
fi

echo "Done! Restart your shell or run: source ~/.bashrc"
{{- end -}}
