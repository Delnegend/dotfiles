{
  "mempalace-recall": {
    "SessionStart": [
      {
        "type": "command",
        "command": {{ printf "bun \"%s\"" (joinPath .chezmoi.homeDir ".config/mempalace/mempalace-recall.ts") | toJson }},
        "timeout": 5
      }
    ]
  }{{ if eq .chezmoi.os "linux" }},
  "zero-g-observations": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "ZERO_G_URL=https://ai.delnegend.com ZERO_G_VIRTUAL_KEY=\"${ZERO_G_TOKEN:-}\" zero-g-agy-integration observe",
        "timeout": 5
      }
    ]
  }{{ end }}
}
