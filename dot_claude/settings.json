{
  "apiKeyHelper": "bun \"$HOME/.claude/zero-g-key.ts\"",
  "env": {
    "ANTHROPIC_BASE_URL": "https://ai.delnegend.com"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.gemini/config/mempalace-recall.ts\" --claude",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  }
}
