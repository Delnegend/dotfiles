{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "integrated-browser-mcp": {
      "command": "node",
      "args": [{{ printf "%s/.integrated-browser-mcp/mcp-server.mjs" .chezmoi.homeDir | toJson }}],
      "enabled": true
    },
    "playwright": {
      "command": "bunx",
      "args": ["@playwright/mcp@latest", "--cdp-endpoint", "ws://localhost:9222"],
      "enabled": true
    },
    "mikrotik": {
      "command": "mikrotik-mcp",
      "args": ["${MIKROTIK_IP_ADDRESS}"],
      "env": {
        "MIKROTIK_USER": "${MIKROTIK_USER}",
        "MIKROTIK_PASSWORD": "${MIKROTIK_PASSWORD}",
        "MIKROTIK_API_SSL": "false"
      }
    },
    "mempalace": {
      "type": "http",
      "url": "https://mempalace.delnegend.com/mcp",
      "headers": {
        "Authorization": "Bearer ${MEMPALACE_MCP_HTTP_TOKEN}",
        "X-MemPalace-Wing": "coding"
      },
      "enabled": true
    }
  }
}
