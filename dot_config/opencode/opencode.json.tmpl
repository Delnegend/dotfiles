{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "bazzite": {
      "name": "Bazzite llama.cpp",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://100.76.230.64:8080/v1"
      },
      "models": {
        "qwen3.8-27b": {
          "modelID": "/models/Qwen3.8-27B-Uncensored-IQ4_XS.gguf",
          "name": "Qwen3.8 27B",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "@playwright/mcp@latest",
          "--cdp-endpoint",
          "ws://localhost:9222"
        ]
      },
      "mikrotik": {
        "type": "local",
        "command": [
          "mikrotik-mcp",
          "{env:MIKROTIK_IP_ADDRESS}"
        ],
        "environment": {
          "MIKROTIK_USER": "{env:MIKROTIK_USER}",
          "MIKROTIK_PASSWORD": "{env:MIKROTIK_PASSWORD}",
          "MIKROTIK_API_SSL": "false"
        }
      },
      "mempalace": {
        "type": "remote",
        "url": "https://mempalace.delnegend.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:MEMPALACE_MCP_HTTP_TOKEN}"
        }
      },
      "openwiki": {
        "type": "local",
        "command": [
          "bunx",
          "openwiki",
          "mcp",
          "--host",
          "omp"
        ]
      }
    }
  },
  "plugins": [
    "{{ .chezmoi.homeDir }}/.config/opencode/mempalace",
    "opencode-models-discovery@2.1.0"
  ]
}
