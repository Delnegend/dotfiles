{{- if eq .chezmoi.hostname "bazzite" -}}
#!/bin/bash
set -e
# Install Iosevka and JetBrains Mono Nerd Fonts and Noto Color Emoji if not present.
# fonts.conf hash: {{ include "dot_config/fontconfig/fonts.conf" | sha256sum }}

if [ ! -f ~/.local/share/fonts/IosevkaNerdFont-Regular.ttf ]; then
	curl -fsSLo /tmp/Iosevka.tar.xz https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.0/Iosevka.tar.xz
	echo "b43fcd131673852bf9fbcca4a553455c8d14c161eda4fc78b52fafb3ed73cf4a /tmp/Iosevka.tar.xz" | sha256sum -c
	mkdir -p /tmp/iosevka
	tar -xJf /tmp/Iosevka.tar.xz -C /tmp/iosevka \
		IosevkaNerdFont-ExtraLight.ttf \
		IosevkaNerdFont-ExtraLightItalic.ttf \
		IosevkaNerdFont-Light.ttf \
		IosevkaNerdFont-LightItalic.ttf \
		IosevkaNerdFont-Italic.ttf \
		IosevkaNerdFont-Regular.ttf \
		IosevkaNerdFont-Bold.ttf \
		IosevkaNerdFont-BoldItalic.ttf
	mkdir -p ~/.local/share/fonts
	mv /tmp/iosevka/*.ttf ~/.local/share/fonts/
	rm -rf /tmp/Iosevka.tar.xz /tmp/iosevka
else
	echo "Iosevka Nerd Font already installed"
fi

if [ ! -f ~/.local/share/fonts/JetBrainsMonoNerdFont-Regular.ttf ]; then
	curl -fsSLo /tmp/JetBrainsMono.tar.xz https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.0/JetBrainsMono.tar.xz
	echo "0227b220360a6f819b9ead92343e8112b34733054782561af50cfba1e8afab63 /tmp/JetBrainsMono.tar.xz" | sha256sum -c
	mkdir -p /tmp/jetbrainsmono
	tar -xJf /tmp/JetBrainsMono.tar.xz -C /tmp/jetbrainsmono \
		JetBrainsMonoNerdFont-ExtraLight.ttf \
		JetBrainsMonoNerdFont-ExtraLightItalic.ttf \
		JetBrainsMonoNerdFont-Light.ttf \
		JetBrainsMonoNerdFont-LightItalic.ttf \
		JetBrainsMonoNerdFont-Italic.ttf \
		JetBrainsMonoNerdFont-Regular.ttf \
		JetBrainsMonoNerdFont-Bold.ttf \
		JetBrainsMonoNerdFont-BoldItalic.ttf
	mkdir -p ~/.local/share/fonts
	mv /tmp/jetbrainsmono/*.ttf ~/.local/share/fonts/
	rm -rf /tmp/JetBrainsMono.tar.xz /tmp/jetbrainsmono
else
	echo "JetBrains Mono Nerd Font already installed"
fi

if [ ! -f ~/.local/share/fonts/NotoColorEmoji.ttf ]; then
	curl -fsSLo /tmp/NotoColorEmoji.ttf https://github.com/googlefonts/noto-emoji/raw/refs/heads/main/fonts/NotoColorEmoji.ttf
	echo "72a635cb3d2f3524c51620cdde406b217204e8a6a06c6a096ff8ed4b5fd6e27b  /tmp/NotoColorEmoji.ttf" | sha256sum -c
	mkdir -p ~/.local/share/fonts
	mv /tmp/NotoColorEmoji.ttf ~/.local/share/fonts/
else
	echo "Noto Color Emoji already installed"
fi

fc-cache -f
{{- end -}}
